              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/DESKTOP-PGSK49B;WideWorldImportersDW\",",
                "    Cube_Sales = Source{[Schema=\"Cube\",Item=\"Sales\"]}[Data]",
                "in",
                "    Cube_Sales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": " SUM(Sales[Total Excluding Tax])"
          },
          {
            "name": "Total Sales Incl Tax",
            "expression": " SUM(Sales[Total Including Tax])"
          },
          {
            "name": "Total Profit",
            "expression": " SUM(Sales[Profit])"
          },
          {
            "name": "Profit Margin %",
            "expression": " DIVIDE([Total Profit], [Total Sales])"
          },
          {
            "name": "Quantity Sold",
            "expression": " SUM(Sales[Quantity])"
          },
          {
            "name": "Invoice Line Count",
            "expression": " SUM(Sales[Sales Count])"
          },
          {
            "name": "Invoices",
            "expression": " DISTINCTCOUNT(Sales[WWI Invoice ID])"
          },
          {
            "name": "Avg Invoice Value",
            "expression": " DIVIDE([Total Sales], [Invoices])"
          },
          {
            "name": "Sales YTD",
            "expression": " TOTALYTD([Total Sales], 'Date'[Date])"
          },
          {
            "name": "Sales Fiscal YTD",
            "expression": " TOTALYTD([Total Sales], 'Date'[Date], \"10/31\")"
          },
          {
            "name": "Sales PY",
            "expression": " CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))"
          },
          {
            "name": "Sales YoY %",
            "expression": " DIVIDE([Total Sales] - [Sales PY], [Sales PY])"
          },
          {
            "name": "Sales by Delivery Date",
            "expression": " CALCULATE([Total Sales], USERELATIONSHIP(Sales[Delivery Date Key], 'Date'[Date]))"
          }
        ]
      },
